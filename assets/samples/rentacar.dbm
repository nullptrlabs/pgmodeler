<database name="rentacar" encoding="UTF8" is-template="false" allow-conns="true">
	<role name="postgres"/>
	<tablespace name="pg_default"/>
</database>

<schema name="public" layers="0" fill-color="#e1e1e1" name-color="#000000" sql-disabled="true">
</schema>

<usertype name="vehicle_category" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="hatchback"/>
	<enumeration label="sedan"/>
	<enumeration label="suv"/>
	<enumeration label="pickup"/>
	<enumeration label="minivan"/>
	<enumeration label="sports"/>
	<enumeration label="van"/>
</usertype>

<usertype name="vehicle_status" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="available"/>
	<enumeration label="rented"/>
	<enumeration label="maintenance"/>
	<enumeration label="inactive"/>
</usertype>

<usertype name="rental_status" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="reserved"/>
	<enumeration label="in_progress"/>
	<enumeration label="completed"/>
	<enumeration label="canceled"/>
</usertype>

<usertype name="vehicle_color" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="silver"/>
	<enumeration label="white"/>
	<enumeration label="black"/>
	<enumeration label="gray"/>
	<enumeration label="red"/>
	<enumeration label="blue"/>
</usertype>

<usertype name="person_type" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="I"/>
	<enumeration label="C"/>
</usertype>

<usertype name="address" configuration="composite">
	<schema name="public"/>
	<role name="postgres"/>
	<typeattrib name="state">
		<type name="character" length="0"/>
	</typeattrib>
	<typeattrib name="postal_code">
		<type name="character varying" length="0"/>
	</typeattrib>
	<typeattrib name="city">
		<type name="character varying" length="0"/>
	</typeattrib>
	<typeattrib name="district">
		<type name="character varying" length="0"/>
	</typeattrib>
	<typeattrib name="number">
		<type name="character varying" length="0"/>
	</typeattrib>
	<typeattrib name="street">
		<type name="character varying" length="0"/>
	</typeattrib>
</usertype>

<domain name="email" not-null="false">
	<schema name="public"/>
	<role name="postgres"/>
	<type name="character varying" length="150"/>
	<constraint name="email_domain_check" type="check">
		<expression> <![CDATA[((VALUE)::text ~* '^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'::text)]]> </expression>
	</constraint>
</domain>

