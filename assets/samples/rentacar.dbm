<view name="vw_model_performance" layers="0" collapse-mode="2" max-obj-count="18" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="60" y="680"/>
	<reference object="public.manufacturer" type="table" ref-name="tb_mon" ref-alias="mfr" use-signature="true" format-name="true"/>
	<reference object="public.vehicle_model" type="table" ref-name="tb_mod" ref-alias="vm" use-signature="true" format-name="true"/>
	<reference object="public.rental" type="table" ref-name="tb_al" ref-alias="r" use-signature="true" format-name="true"/>
	<reference object="public.rental.id" type="column" ref-name="al_id" format-name="true"/>
	<reference object="public.rental.start_date" type="column" ref-name="al_dt_inicio"/>
	<reference object="public.rental.end_date" type="column" ref-name="al_dt_fim"/>
	<reference object="public.rental.status" type="column" ref-name="al_status"/>
	<reference object="public.rental.daily_rate" type="column" ref-name="al_val_diaria"/>
	<reference object="public.rental.vehicle_model_id" type="column" ref-name="al_mod_id"/>
	<reference object="public.vehicle_model.id" type="column" ref-name="m_id" ref-alias="vehicle_model_id" use-columns="true"/>
	<reference object="public.vehicle_model.manufacturer_id" type="column" ref-name="m_mon_id"/>
	<reference object="public.manufacturer.name" type="column" ref-name="mon_nome" ref-alias="manufacturer" use-columns="true"/>
	<reference object="public.vehicle_model.name" type="column" ref-name="m_nome" ref-alias="model" use-columns="true"/>
	<reference object="public.vehicle_model.category" type="column" ref-name="m_categoria" use-columns="true"/>
	<reference object="public.manufacturer.id" type="column" ref-name="mon_id"/>
	<simplecol name="total_rentals" type="integer"/>
	<simplecol name="total_revenue" type="numeric(12,2)"/>
	<definition> <![CDATA[SELECT
  @{tb_mod}.{m_id} AS @{m_id},
  @{tb_mon}.{mon_nome} AS @{mon_nome},
  @{tb_mod}.{m_nome} AS @{m_nome},
  @{tb_mod}.{m_categoria},
  COUNT(@{tb_al}.{al_id}) AS total_rentals,
  COALESCE(
      SUM(
          CASE
              WHEN @{tb_al}.{al_status} IN ('completed', 'in_progress')
              THEN ((@{tb_al}.{al_dt_fim} -
                     @{tb_al}.{al_dt_inicio} + 1) *
                     @{tb_al}.{al_val_diaria})
              ELSE 0
          END
      ), 0.00
  )::numeric(12,2) AS total_revenue
FROM {tb_mod} AS @{tb_mod}
JOIN {tb_mon} AS @{tb_mon}
  ON @{tb_mod}.{m_mon_id} = @{tb_mon}.{mon_id}
LEFT JOIN {tb_al} AS @{tb_al}
  ON @{tb_al}.{al_mod_id} = @{tb_mod}.{m_id}
GROUP BY @{tb_mod}.{m_id}, @{tb_mon}.{mon_nome},
         @{tb_mod}.{m_nome},  @{tb_mod}.{m_categoria}
ORDER BY total_rentals DESC, total_revenue DESC
]]> </definition>
</view>

